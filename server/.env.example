# Runtime
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/beyonist

# Browser origins allowed to call the API with credentials.
# Multiple origins may be comma-separated if required.
CLIENT_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Customer/order email notifications (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Beyonist <orders@your-verified-domain.com>

# Development only. Keep false unless you intentionally want raw admin reset
# links printed to the local server terminal while testing password reset.
ALLOW_DEV_RESET_LINKS=false

# One-time administrator bootstrap. Run `npm run seed:admin`, verify login,
# then remove ADMIN_PASSWORD from the real .env file.
ADMIN_NAME=Beyonist Administrator
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-10-plus-character-password

# Production requirements:
# - NODE_ENV=production
# - CLIENT_URL and PUBLIC_SITE_URL must be HTTPS
# - terminate TLS at your reverse proxy/platform
# - never commit .env or expose ADMIN_PASSWORD/RESEND_API_KEY to the client
